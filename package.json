{
  "name": "claude-swarm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Claude Swarm - an unofficial Snake-style fan game with a swarm of pixel bots.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
