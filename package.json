    "test:e2e": "playwright test",
    "serve:subpath": "node scripts/serve-dist.mjs 4174"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
