    "test:e2e": "playwright test",
    "serve:subpath": "node scripts/serve-dist.mjs 4174",
    "assets": "node scripts/make-assets.mjs public social-preview-v3.png",
    "shots": "node scripts/readme-shots.mjs docs"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
