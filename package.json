{
  "name": "claude-swarm",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "description": "Claude Swarm - an unofficial Snake-style fan game: consume tokens, spawn agents, grow your swarm. Built by CyberSquad0 + Claude.",
  "author": {
    "name": "CyberSquad0",
    "url": "https://www.cs0.dev"
  },
  "homepage": "https://meridian-knight.github.io/claude-swarm/",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "tsc --noEmit && vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve:subpath": "node scripts/serve-dist.mjs 4174",
    "assets": "node scripts/make-assets.mjs public social-preview-v4.png",
    "shots": "node scripts/readme-shots.mjs docs"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
